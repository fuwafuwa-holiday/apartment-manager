{
  "name": "apartment-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run build:renderer && wrangler dev",
    "dev:renderer": "next dev renderer",
    "dev:worker": "wrangler dev",
    "build:renderer": "next build renderer && next export renderer",
    "build": "npm run build:renderer",
    "deploy": "npm run build && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply apartment-manager --local",
    "db:migrate": "wrangler d1 migrations apply apartment-manager --remote",
    "type-check": "tsc -p renderer/tsconfig.json && tsc -p worker/tsconfig.json"
  },
  "dependencies": {
    "@emotion/react": "^11.10.5",
    "@emotion/styled": "^11.10.5",
    "@fontsource/roboto": "^4.5.8",
    "@mui/icons-material": "^5.11.0",
    "@mui/material": "^5.11.2",
    "@tanstack/react-query": "^4.20.4",
    "@trpc/client": "^10.7.0",
    "@trpc/next": "^10.7.0",
    "@trpc/react-query": "^10.7.0",
    "@trpc/server": "^10.7.0",
    "array-move": "^4.0.0",
    "classnames": "^2.3.2",
    "dayjs": "^1.11.7",
    "drizzle-orm": "^0.44.0",
    "framer-motion": "^8.0.2",
    "jose": "^5.9.6",
    "lodash": "^4.17.21",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.41.1",
    "react-sortable-hoc": "^2.0.0",
    "superjson": "^1.12.1",
    "ulid": "^2.3.0",
    "zod": "^3.20.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261025.1",
    "@types/lodash": "^4.14.191",
    "@types/node": "^20.11.0",
    "@types/react": "^18.0.26",
    "@types/react-dom": "^18.0.10",
    "drizzle-kit": "^0.31.0",
    "next": "13.1.1",
    "prettier": "^2.8.1",
    "sass": "^1.57.1",
    "typescript": "^5.9.0",
    "wrangler": "^4.0.0"
  }
}
